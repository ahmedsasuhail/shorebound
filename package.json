{
  "name": "shorebound",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Find recent visa-sponsored software jobs abroad, ranked by trust. Local-first desktop/web app.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "npm run validate -w @shorebound/data-schema"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
